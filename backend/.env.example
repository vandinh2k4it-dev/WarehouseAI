DATABASE_URL=postgresql+psycopg2://postgres:MATKHAU_CUA_BAN@localhost:5432/warehouse_db

# Chatbot Claude API (mục 6.6) — lấy tại platform.claude.com -> Settings -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Model YOLOv8 đã train (mục 6.3) — đường dẫn tới file .pt, để trống dùng tạm yolov8s.pt
CARTON_MODEL_PATH=models/carton_counter_best.pt

# CORS — domain frontend được phép gọi API. Dev để "*", khi deploy Railway
# PHẢI đổi thành đúng domain Vercel thật, nhiều domain phân cách bằng dấu phẩy:
#   CORS_ORIGINS=https://ten-du-an.vercel.app,https://ten-du-an-git-main.vercel.app
CORS_ORIGINS=*

# Push notification (Web Push) — đẩy cảnh báo ra điện thoại. Sinh 1 lần bằng
# lệnh: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
# (xem hướng dẫn đầy đủ trong tin nhắn Claude gửi kèm) — dán đúng 2 khoá vào
# đây, KHÔNG BAO GIỜ để lộ VAPID_PRIVATE_KEY (không commit file .env thật vào git).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=your-email@example.com
