DATABASE_URL=postgresql+psycopg2://postgres:MATKHAU_CUA_BAN@localhost:5432/warehouse_db

# Chatbot Gemini API (mục 6.6) — key MIỄN PHÍ tại https://aistudio.google.com/apikey
# Thiếu key (hoặc Gemini lỗi/hết hạn mức 429) thì chatbot tự rơi về chế độ MOCK
# (trả lời theo mẫu cố định, vẫn tra DB thật).
GEMINI_API_KEY=
# Đặt 1/true để ÉP dùng MOCK dù đã có key (hữu ích khi demo không có mạng). Để trống = dùng AI thật.
CHATBOT_MOCK=

# Model YOLOv8 đã train (mục 6.3) — đường dẫn tới file .pt, để trống dùng tạm yolov8s.pt
CARTON_MODEL_PATH=models\carton_counter_best_yolov8s.pt

# CORS — domain frontend được phép gọi API. Chạy local/demo để "*"; nếu sau này
# deploy lại lên server thật thì đổi thành đúng domain frontend, nhiều domain
# phân cách bằng dấu phẩy:
#   CORS_ORIGINS=https://ten-mien-cua-ban.com,http://localhost:5173
CORS_ORIGINS=*

# Ảnh phiếu nhập: thư mục lưu (mặc định ./uploads/receipts) và dung lượng tối đa mỗi ảnh (MB, mặc định 15)
# RECEIPT_UPLOAD_DIR=./uploads/receipts
# MAX_RECEIPT_IMAGE_MB=15

# Push notification (Web Push) — đẩy cảnh báo ra điện thoại. Sinh 1 lần bằng
# lệnh: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
# — dán đúng 2 khoá vào đây, KHÔNG BAO GIỜ để lộ VAPID_PRIVATE_KEY (file .env
# thật đã nằm trong .gitignore, đừng commit). Để trống thì tính năng push tự tắt.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Chỉ cần email, KHÔNG cần gõ 'mailto:' (code tự thêm; nếu lỡ gõ cũng được bỏ đi)
VAPID_CLAIM_EMAIL=your-email@example.com
